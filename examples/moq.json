{
  "app": "sample",
  "server": {
    "port": 8080,
    "adminHost": "127.0.0.1",
    "readinessPath": "/_admin/endpoints",
    "readinessTimeoutSeconds": 30,
    "adminAuth": { "kind": "none" }
  },
  "auth": {
    "provider": "test-routes",
    "baseURL": "http://127.0.0.1:8081",
    "sessionHeader": "X-Test-Session",
    "launchEnvironment": {
      "APP_TEST_SESSION": "{{sessionId}}"
    },
    "routes": {
      "release": { "method": "DELETE", "path": "/_test/sessions/{session}" },
      "disable_user": { "method": "PUT", "path": "/_test/accounts/{email}/disabled" },
      "enable_user": { "method": "DELETE", "path": "/_test/accounts/{email}/disabled" }
    }
  },
  "platforms": {
    "ios": {
      "appHost": "127.0.0.1",
      "requireSession": true,
      "launchEnvironment": {
        "APP_MOCK_BASE_URL": "{{baseURL}}",
        "APP_MOCK_SESSION": "{{sessionId}}",
        "APP_AUTH_EMULATOR_HOST": "127.0.0.1:9099"
      }
    },
    "android": {
      "appHost": "10.0.2.2",
      "requireSession": false,
      "launchEnvironment": {
        "APP_MOCK_BASE_URL": "{{baseURL}}",
        "APP_MOCK_SESSION": "{{sessionId}}",
        "APP_AUTH_EMULATOR_HOST": "10.0.2.2:9099"
      }
    }
  }
}
